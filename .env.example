# This file is a template. Export variables explicitly; the app does not load it.
SECRET_KEY=replace-with-a-persisted-random-value-at-least-32-characters
MEDIA_DATA_DIR=./data
MEDIA_CHAT_API_KEY=replace-with-your-own-key
MEDIA_CHAT_BASE_URL=https://api.openai.com/v1
MEDIA_IMAGE_API_KEY=replace-with-your-own-key
MEDIA_IMAGE_BASE_URL=https://api.openai.com/v1
# Optional explicit runtime JSON. Default: media/config/runtime.json
# MEDIA_RUNTIME_CONFIG=./media/config/runtime-ohmygpt.json
# Optional COS: required for uploading new reference images and durable COS storage.
# TENCENT_CLOUD_SECRET_ID=
# TENCENT_CLOUD_SECRET_KEY=
# TENCENT_CLOUD_COS_REGION=ap-guangzhou
# TENCENT_CLOUD_COS_BUCKET=
# Optional voice: local ASR model installed separately, never auto-discovered.
# VOICE_STREAM_MODEL_DIR=./voice-model
# VOICE_STREAM_AUTH_URL=http://127.0.0.1:8000/api/auth/me
# VOICE_STREAM_PORT=18766
# Optional HTTP audio transcription; independent of local streaming ASR.
# GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
